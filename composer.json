{
    "name": "bostjanob/filament-file-manager",
    "description": "Filament File Manager",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "file-manager"
    ],
    "homepage": "https://github.com/BostjanOb/filament-file-manager",
    "autoload": {
        "psr-4": {
            "BostjanOb\\FilamentFileManager\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Bostjan",
            "email": "bostjan@muha.cc"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "BostjanOb\\FilamentFileManager\\FilamentFileManagerServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "calebporzio/sushi": "^2.5.4",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0",
        "league/flysystem": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "version": "1.0.0",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "BostjanOb\\FilamentFileManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    }
}
